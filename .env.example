# ── Backend ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# MongoDB connection string (optional)
# Get free cluster at https://www.mongodb.com/atlas
MONGODB_URI=mongodb://localhost:27017/waypointdb

# CORS allowed origin
CORS_ORIGIN=http://localhost:5173

# ── Frontend ──────────────────────────────────────────────────────────────────
# Optional: Add Mapbox key to enable premium satellite layers
VITE_MAPBOX_API_KEY=

# Optional: OpenRouteService key for road snapping
OPENROUTESERVICE_API_KEY=

# Optional: Google Maps API
GOOGLE_MAPS_API_KEY=
